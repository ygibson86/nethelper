POSTGRES_DB=nethelper
POSTGRES_USER=nethelper
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://nethelper:replace-with-a-long-random-password@postgres:5432/nethelper

# Generate once: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-random-bytes

# Generate an Argon2id hash; never put the plain password here.
ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
JWT_TTL_SECONDS=28800

# The public HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://nethelper.example.internal
NETHELPER_PORT=8080
