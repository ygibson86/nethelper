POSTGRES_DB=nethelper
POSTGRES_USER=nethelper
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://nethelper:replace-with-a-long-random-password@postgres:5432/nethelper

# Generate once: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-random-bytes

# Generate an Argon2id hash; never put the plain password here.
ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
JWT_TTL_SECONDS=28800

# The public HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://nethelper.example.internal
NETHELPER_PORT=8080

# Browser SSH terminal. The API resolves device IPs from NetHelper and only
# connects to addresses in this management network.
SSH_ALLOWED_CIDRS=10.109.33.0/24,192.168.31.0/24
SSH_PORT=22
SSH_CONNECT_TIMEOUT_MS=12000
SSH_IDLE_TIMEOUT_SECONDS=1800
SSH_MAX_SESSIONS=20
SSH_MAX_LIFETIME_SECONDS=28800
# Appends compatibility algorithms after modern algorithms for older Eltex devices.
SSH_LEGACY_ELTEX=true
